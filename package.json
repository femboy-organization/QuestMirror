{
  "name": "questmirror",
  "productName": "SPECTRA",
  "version": "0.1.0-pre.1",
  "description": "Windows desktop application for mirroring Meta Quest to a computer display.",
  "main": "dist/main.js",
  "author": "femboy-organization",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "package:win": "npm run build && npx --yes @electron/packager@20.3.0 . SPECTRA --platform=win32 --arch=x64 --out=release --overwrite",
    "test": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "extract-zip": "^2.0.0",
    "fix-path": "^3.0.0"
  }
}