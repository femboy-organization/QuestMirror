<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SPECTRA.App.MainWindow"
        Title="SPECTRA"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        Background="#101116"
        Foreground="#F1F2F6">
  <Grid ColumnDefinitions="230,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="#171920" Padding="18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="20">
          <StackPanel Spacing="3">
            <TextBlock Text="SPECTRA" FontSize="25" FontWeight="Bold" LetterSpacing="2"/>
            <TextBlock Text="QUEST MIRROR" FontSize="10" Foreground="#9296A5" LetterSpacing="2"/>
          </StackPanel>
          <Border Height="1" Background="#30333E"/>
          <Button HorizontalContentAlignment="Left" Content="  Overview" Classes="nav"/>
          <Button HorizontalContentAlignment="Left" Content="  Devices" Classes="nav"/>
          <Button HorizontalContentAlignment="Left" Content="  Streaming" Classes="nav"/>
          <Button HorizontalContentAlignment="Left" Content="  Settings" Classes="nav"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="5">
          <TextBlock Text="REBUILD PREVIEW" FontSize="10" Foreground="#9296A5"/>
          <TextBlock Text="Avalonia · .NET" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="28" RowSpacing="22">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="Connect your Meta Quest and start mirroring." Foreground="#A5A8B5"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#20232C" CornerRadius="9" Padding="14,9" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="#E6B45C" VerticalAlignment="Center"/>
            <TextBlock Text="Not connected" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="18">
        <Border Background="#171920" BorderBrush="#2A2D37" BorderThickness="1" CornerRadius="14" Padding="20">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Live preview" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="The headset feed will appear here." Foreground="#9296A5" FontSize="12"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#252833" CornerRadius="6" Padding="10,5">
                <TextBlock Text="NO SIGNAL" FontSize="10" Foreground="#A5A8B5" LetterSpacing="1"/>
              </Border>
            </Grid>
            <Border Grid.Row="1" Background="#0B0C10" BorderBrush="#30333E" BorderThickness="1" CornerRadius="10">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Border Width="64" Height="64" CornerRadius="32" Background="#1B1E27">
                  <TextBlock Text="◉" FontSize="30" Foreground="#777D91" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Waiting for a headset" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Connect Quest over USB or configure wireless ADB." Foreground="#9296A5" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBlock Text="Stream controls will be enabled after a device is detected." Foreground="#9296A5" FontSize="12" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Refresh devices" Click="OnRefreshDevicesClick"/>
              <Button Grid.Column="2" Content="Start stream" IsEnabled="False"/>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="18">
          <Border Background="#171920" BorderBrush="#2A2D37" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="DEVICE" FontSize="10" Foreground="#9296A5" LetterSpacing="1"/>
              <TextBlock Name="DeviceStatusText" Text="No device detected" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Name="DeviceDetailsText" Text="ADB status has not been checked yet." Foreground="#9296A5" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#171920" BorderBrush="#2A2D37" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="ACTIVITY" FontSize="10" Foreground="#9296A5" LetterSpacing="1"/>
              <TextBlock Name="ActivityStatusText" Text="Ready" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Name="ActivityDetailsText" Text="Application initialized." Foreground="#9296A5" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" Background="#171920" Padding="28,10">
      <TextBlock Text="SPECTRA · Clean rewrite foundation" FontSize="11" Foreground="#777D91"/>
    </Border>
  </Grid>
</Window>